# Copiar a .env.local y completar. NUNCA subir valores al repo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Panel: con SESSION_SECRET, PANEL_USERS = usuario:rol:hash separados por coma (npm run panel:usuario -- <usuario> <tecnico|admin>).
# Sin SESSION_SECRET el panel usa basic auth con usuario:clave (compatibilidad).
PANEL_USERS=
SESSION_SECRET=
CRON_SECRET=
TECNICA_CONTACTO=
DEMO_FIXTURES=auto
PROBAR_TOPE_DIARIO=
GROQ_API_KEY=
# 1 = el bot y la web muestran tarjetas en borrador, SIEMPRE con la etiqueta "BORRADOR · sin verificar". Vacío/otro = apagado.
DEMO_PERMITIR_BORRADOR=
