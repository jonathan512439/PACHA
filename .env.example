# Copiar a .env y completar. NUNCA subir valores al repo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WhatsApp por Twilio (sandbox, para la demo). Con las tres, WhatsApp sale por Twilio en vez de Meta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox, p. ej. +14155238886
TWILIO_WHATSAPP_FROM=
# Opcional: URL exacta del webhook si la firma no coincide (https://<app>/api/webhooks/twilio)
TWILIO_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Panel: con SESSION_SECRET, PANEL_USERS = usuario:rol:hash separados por coma (npm run panel:usuario -- <usuario> <tecnico|admin>).
# Sin SESSION_SECRET el panel usa basic auth con usuario:clave (compatibilidad).
PANEL_USERS=
SESSION_SECRET=
CRON_SECRET=
TECNICA_CONTACTO=
DEMO_FIXTURES=auto
PROBAR_TOPE_DIARIO=
GROQ_API_KEY=
# 1 = el bot y la web muestran tarjetas en borrador, SIEMPRE con la etiqueta "BORRADOR · sin verificar". Vacío/otro = apagado.
DEMO_PERMITIR_BORRADOR=
# Opcionales
# URL pública del sitio (si falta, se usa la de producción de Vercel)
APP_URL=
# Usuario del bot de Telegram para el QR de /suscribirse (sin @)
TELEGRAM_BOT_USERNAME=
# Modelo de voz de Gemini (por defecto gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=
# 1 = el bot manda el audio de bienvenida (bucket audios/bienvenida.*)
AUDIO_BIENVENIDA=
