# Secretos: nunca al repo (solo .env.example, sin valores)
.env*
!.env.example

# Dependencias y builds
node_modules/
.next/
out/
.vercel/

# Pruebas desechables: audios grabados, PDFs descargados y notas de voz (pueden contener voces reales)
scratch/node_modules/
scratch/*.ogg
scratch/*.oga
scratch/*.opus
scratch/*.webm
scratch/*.wav
scratch/*.mp3
scratch/*.mp4
scratch/*.m4a
scratch/*.pdf

# Sistema
.DS_Store
Thumbs.db
*.log

# Next.js / TypeScript
/build
/coverage
*.pem
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.*

# Salidas de pruebas desechables (los fixtures oficiales están en /fixtures)
scratch/fixtures/

# Tarjetas: imágenes y audios van a Supabase Storage, no a git (ver decisiones.md)
assets/lessons/
assets/audio/*
!assets/audio/.gitkeep
exports/
# Paquete original de tarjetas (ya copiado a data/, assets/, docs/ y fusionado en contratos/)
paquete_tarjetas/
# Citas literales de verificación: solo en Drive, nunca en el repo público
verificacion_paso_a_paso.csv
**/verificacion_paso_a_paso.csv

# Hoja de verificación de tarjetas: contiene citas literales de las fuentes (van solo a Drive, nunca al repo)
scratch/verificacion/
